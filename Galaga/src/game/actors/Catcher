package game.actors;

public class Catcher extends Ennemy{
    public Catcher (double x, double y, double length, double speedX, double speedY, String spriteFile) {
        super(x, y, 0.006, 0.0, 0.002, "catcher.spr");
    }

    public void move() {
        y -= speedY;

        if (y < 0.000) {
            alive = false; //l'ennemi sort de l'écran
        }
    }
}
